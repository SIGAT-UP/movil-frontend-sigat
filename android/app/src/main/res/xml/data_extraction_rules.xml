<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no copiar datos de SIGAT a la nube ni a otro dispositivo.
     La cola de registros pendientes y la sesión viven solo en este teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
